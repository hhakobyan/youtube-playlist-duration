{
  "manifest_version": 3,
  "name": "Playlist Total Duration for YouTube",
  "short_name": "Playlist Duration",
  "version": "1.0.0",
  "description": "Shows the total duration of the current YouTube playlist next to the position counter (e.g. 1 / 5 4:25:14).",
  "homepage_url": "https://github.com/hhakobyan/youtube-playlist-duration",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
