{
  "manifest_version": 3,
  "name": "Playlist Duration & Controls for YouTube",
  "short_name": "Playlist Duration",
  "version": "1.0.0",
  "description": "Shows the total playlist duration (e.g. 1 / 5 4:25:14) and the player controls when you play/pause with earphones or media keys.",
  "homepage_url": "https://github.com/hhakobyan/youtube-playlist-duration",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Playlist Duration & Controls settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["media-keys.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
